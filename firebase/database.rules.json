{
  "rules": {
    ".read": false,
    ".write": false,

    "Users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('Proveedores').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        "pass": { ".validate": false },
        "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "apel": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "mail": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "Direcciones": {
          "$dirId": {
            ".validate": "newData.hasChildren(['name', 'ciudad', 'direccion', 'dirComplete'])"
          }
        }
      }
    },

    "Pedido": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !newData.exists()",
        "$pedidoId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('Proveedores').child(auth.uid).exists())",
          ".validate": "newData.child('id').val() === $uid"
        }
      }
    },

    "Pedidos": {
      ".read": "auth != null && root.child('Proveedores').child(auth.uid).exists()",
      ".indexOn": ["state", "Tipo", "createdAt", "id"],
      "$pedidoId": {
        ".read": "auth != null && data.child('id').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('id').val() === auth.uid) || root.child('Proveedores').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['id', 'Tipo', 'state', 'date'])"
      }
    },

    "Proveedores": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
