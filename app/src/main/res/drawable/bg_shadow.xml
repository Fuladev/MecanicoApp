<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item android:left="0dp" android:top="0dp">
                <shape>
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="180"
                        android:endColor="@color/shadowend"
                        android:startColor="@color/shadowstar"
                        android:type="linear"
                        android:centerX="0"
                        android:centerY="0.5"
                        android:gradientRadius="300"/>
                    <padding android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="1dp" android:right="1dp" android:top="1dp" >
                <shape>
                    <corners android:radius="12dp" />
                    <solid android:color="#F1EFEF" />


                </shape>
            </item>


        </layer-list>
    </item>

</selector>