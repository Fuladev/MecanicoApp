<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo2"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/degradadonegro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/back_btn"
            android:layout_width="20sp"
            android:layout_height="20sp"
            android:layout_marginStart="15dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/arrowback"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/linearLayout6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginLeft="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginRight="40dp"
        android:background="@drawable/fondofield"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/constraintLayout">


        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:fontFamily="@font/montserrat"
            android:gravity="center"
            android:text="Sign In"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="24sp" />

        <EditText
            android:id="@+id/et_mail"
            android:layout_width="match_parent"
            android:layout_height="45sp"
            android:layout_margin="10sp"
            android:background="@drawable/border_style"
            android:ems="10"
            android:fontFamily="@font/montserrat"
            android:hint="@string/txt_correo"
            android:inputType="textEmailAddress"
            android:textColor="@color/letra"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_pass"
            android:layout_width="match_parent"
            android:layout_height="45sp"
            android:layout_margin="10sp"
            android:background="@drawable/border_style"
            android:ems="10"
            android:fontFamily="@font/montserrat"
            android:hint="@string/txt_pass"
            android:inputType="textPassword"
            android:textColor="@color/letra"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_log"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="45sp"
            android:layout_margin="10sp"
            android:background="@drawable/border_buttom"
            android:text="SignIn with Email"
            android:textAllCaps="false"
            android:textColor="@android:color/background_light" />

        <Button
            android:id="@+id/btn_google"
            android:layout_width="match_parent"
            android:layout_height="45sp"
            android:layout_margin="10sp"
            android:background="@drawable/bg_white"
            android:drawableStart="@drawable/googleg_standard_color_18"
            android:drawableLeft="@drawable/googleg_standard_color_18"
            android:fontFamily="@font/montserrat"
            android:text="SignIn with Google"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary"
            android:textSize="12sp" />


        <Button
            android:id="@+id/btn_createC"
            android:layout_width="wrap_content"
            android:layout_height="45sp"
            android:layout_margin="10sp"
            android:background="@drawable/border"
            android:fontFamily="@font/montserrat"
            android:text="Create account with email"
            android:textAllCaps="false"
            android:textColor="@color/blanco"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50sp"
            android:layout_weight="1"
            android:ems="10"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:text="@string/txt_olvidar"
            android:textColor="@color/letra"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>