<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    tools:context=".OtrosActivity">

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="match_parent"
        android:layout_height="120sp"
        android:layout_margin="20sp"
        android:src="@drawable/portada_fb_mec"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/back_btn"
        android:layout_width="25sp"
        android:layout_height="25sp"
        android:layout_margin="5sp"
        android:layout_weight="1"
        app:srcCompat="@drawable/ic_arrow_back"
        tools:ignore="MissingConstraints,VectorDrawableCompat" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/blanco"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">



            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="20sp">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10sp"
                    android:layout_marginRight="10sp"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_coser"
                        style="@style/Widget.AppCompat.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="95dp"
                        android:layout_margin="10sp"
                        android:background="@drawable/bg_white"
                        android:drawableTop="@drawable/ic_coser"
                        android:fontFamily="@font/montserrat"
                        android:gravity="bottom|center"
                        android:padding="10sp"
                        android:text="M. de Coser"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_obras"
                        android:layout_width="80sp"
                        android:layout_height="95dp"
                        android:layout_margin="10sp"
                        android:background="@drawable/bg_white"
                        android:drawableTop="@drawable/ic_obras"
                        android:fontFamily="@font/montserrat"
                        android:gravity="bottom|center"
                        android:lines="2"
                        android:padding="10sp"
                        android:text="Reformas Locativas"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_pc"
                        android:layout_width="80sp"
                        android:layout_height="95dp"
                        android:layout_margin="10sp"
                        android:background="@drawable/bg_white"
                        android:drawableTop="@drawable/ic_pc"
                        android:fontFamily="@font/montserrat"
                        android:gravity="bottom|center"
                        android:lines="2"
                        android:padding="10sp"
                        android:text="Equipos de computo"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                        android:textSize="10sp"
                        android:typeface="normal" />

                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10sp"
                    android:layout_marginRight="10sp"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_doctor"
                        style="@style/Widget.AppCompat.Button"
                        android:layout_width="70sp"
                        android:layout_height="95dp"
                        android:layout_margin="10sp"
                        android:background="@drawable/bg_white"
                        android:drawableTop="@drawable/ic_doctor"
                        android:fontFamily="@font/montserrat"
                        android:gravity="bottom|center"
                        android:inputType="textMultiLine"
                        android:lines="2"
                        android:padding="10sp"
                        android:text="Servicio Medico"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_belleza"
                        style="@style/Widget.AppCompat.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="95dp"
                        android:layout_margin="10sp"
                        android:background="@drawable/bg_white"
                        android:drawableTop="@drawable/ic_belleza"
                        android:fontFamily="@font/montserrat"
                        android:gravity="bottom|center"
                        android:padding="10sp"
                        android:text="Belleza"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_white"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="93dp"
                        android:layout_margin="10sp"
                        android:background="@android:color/white"
                        android:fontFamily="@font/montserrat"
                        android:gravity="bottom|center" />

                </TableRow>

            </TableLayout>

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>