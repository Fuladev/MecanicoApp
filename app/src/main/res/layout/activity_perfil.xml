<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    tools:context=".PerfilActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout5"
        android:layout_width="match_parent"
        android:layout_height="180sp"
        android:background="@drawable/profile_bg"
        android:orientation="horizontal"
        android:padding="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="25sp"
            android:layout_height="25sp"
            android:layout_margin="5sp"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_arrow_back"
            tools:ignore="VectorDrawableCompat" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollView4"
        android:layout_width="410dp"
        android:layout_height="650dp"
        android:layout_marginTop="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30sp"
            android:layout_marginTop="10sp"
            android:layout_marginRight="30sp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tx_cel"
                android:layout_width="match_parent"
                android:layout_height="40sp"
                android:layout_marginBottom="10sp"
                android:layout_weight="1"
                android:drawablePadding="5sp"
                android:fontFamily="@font/montserrat"
                android:gravity="center_vertical"
                android:text="Número de telefono"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="@color/letra"
                app:drawableStartCompat="@drawable/ic_cel"
                app:drawableLeftCompat="@drawable/ic_cel" />

            <TextView
                android:id="@+id/tx_mail"
                android:layout_width="match_parent"
                android:layout_height="40sp"
                android:layout_marginBottom="10sp"
                android:layout_weight="1"
                android:drawablePadding="5sp"
                android:fontFamily="@font/montserrat"
                android:gravity="center_vertical"
                android:text="@string/txt_correo"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="@color/letra"
                app:drawableStartCompat="@drawable/ic_mail"
                app:drawableLeftCompat="@drawable/ic_mail" />


            <Button
                android:id="@+id/sign_out"
                android:layout_width="match_parent"
                android:layout_height="40sp"
                android:layout_marginBottom="10sp"
                android:background="@color/trasparente"
                android:drawableStart="@drawable/ic_back"
                android:drawablePadding="5sp"
                android:fontFamily="@font/montserrat"
                android:gravity="center_vertical"
                android:text="Sign Out"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="@color/letra"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginLeft="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_shadow"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/scrollView4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="100sp"
            android:layout_height="80sp"
            app:srcCompat="@drawable/ic_profile" />

        <TextView
            android:id="@+id/tx_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Nombre"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tx_apel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20sp"
            android:gravity="center"
            android:text="Apellido"
            android:textSize="14sp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>